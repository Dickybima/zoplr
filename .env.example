# ===== Mode chain =====
# fork    = Anvil lokal yang mem-fork mainnet (dana palsu, aman untuk dev)
# mainnet = Robinhood Chain mainnet (uang sungguhan!)
ZOPLR_CHAIN_MODE=fork

# RPC mainnet Robinhood Chain (dipakai Anvil untuk fork, dan langsung saat mode mainnet)
MAINNET_RPC_URL=
# RPC lokal Anvil
FORK_RPC_URL=http://127.0.0.1:8545
# Pin block supaya hasil fork konsisten (opsional)
FORK_BLOCK_NUMBER=

# Chain ID Robinhood Chain mainnet (isi dari docs resmi)
PONS_CHAIN_ID=
# Alamat factory Pons V2 (WAJIB dari docs/explorer resmi, jangan dari artikel)
PONS_FACTORY_ADDRESS=
# Block saat factory di-deploy (supaya indexer tidak scan dari block 0)
PONS_FACTORY_START_BLOCK=0

# Variabel publik untuk browser (Next.js)
NEXT_PUBLIC_ZOPLR_CHAIN_MODE=fork
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_PONS_CHAIN_ID=
NEXT_PUBLIC_PONS_FACTORY_ADDRESS=
# Whitelist wallet yang boleh launch di mainnet (pisahkan dengan koma). Kosong = semua boleh.
NEXT_PUBLIC_LAUNCH_ALLOWLIST=

# ===== Database =====
DATABASE_URL=postgres://zoplr:zoplr@localhost:5432/zoplr

# ===== AI =====
ANTHROPIC_API_KEY=
# Model default untuk agent (bisa di-override per agent)
ZOPLR_DEFAULT_MODEL=claude-opus-5-5
# Batas pesan chat per IP per menit
CHAT_RATE_LIMIT_PER_MIN=20
